config BOARD_X40
    select SOC_NRF52840_QIAA
    select ZMK_BOARD_COMPAT if BOARD_X40_NRF52840_ZMK
    imply RETAINED_MEM if BOARD_X40_NRF52840_ZMK
    imply RETENTION if BOARD_X40_NRF52840_ZMK
    imply RETENTION_BOOT_MODE if BOARD_X40_NRF52840_ZMK
