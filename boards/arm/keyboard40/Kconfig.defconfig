if BOARD_KEYBOARD40

config BOARD
    default "keyboard40"

config ARM_MPU
    default y

config USB
    bool
    default y

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

config BT
    default y

config BT_CTLR
    default y

config ZMK_BLE
    default y

config ZMK_USB
    default y

config FLASH
    default y
    depends on SOC_FLASH_NRF || FLASH_HAS_DRIVER

config FLASH_HAS_DRIVER_ENABLED
    default y

config FLASH_HAS_PAGE_LAYOUT
    default y

config FLASH_PAGE_LAYOUT
    default y

config FLASH_MAP
    default y


config SETTINGS
    default y

config SETTINGS_NVS
    default y

config SERIAL_SUPPORT_INTERRUPT
    default y

endif # BOARD_KEYBOARD40